# Copy to .env.local and fill in (see SETUP.md). .env.local is git-ignored.
# Leave everything empty to run in demo mode (test key, demo tag only).

# Firebase web app config (public identifiers): Project settings → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public tag-signing key from `npm run keys`, e.g. {"1":"04ab…"}
NEXT_PUBLIC_TAG_PUBLIC_KEYS=

# --- SECRETS below: never commit, never share ---
# Firebase service-account JSON (one line) or the file base64-encoded
FIREBASE_SERVICE_ACCOUNT=
# From `npm run keys`
TAG_SIGNING_KEY=
TAG_SECRET_KEY=
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=records

# The site's public URL; the tags link to <this>/e/<tagId>
PUBLIC_BASE_URL=http://localhost:3000
