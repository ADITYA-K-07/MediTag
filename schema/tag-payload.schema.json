{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meditag.app/schema/tag-payload.v1.json",
  "title": "MediTag emergency payload (v1)",
  "description": "Compact Tier-1 emergency data stored on the NTAG216 inside the application/vnd.meditag.v1 MIME record. Short keys keep the tag under 888 bytes. Field order on the tag is whatever the server signed; clients verify the exact stored bytes and never re-serialise.",
  "type": "object",
  "required": ["v", "tid", "n", "ts"],
  "additionalProperties": false,
  "properties": {
    "v":   { "const": 1, "description": "Payload version" },
    "tid": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$", "description": "Random tag id (96 bits, base64url)" },
    "n":   { "type": "string", "maxLength": 60, "description": "Full name" },
    "dob": { "type": "string", "format": "date", "description": "Date of birth, YYYY-MM-DD" },
    "sx":  { "enum": ["M", "F", "O"], "description": "Sex" },
    "bg":  { "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"], "description": "Blood group" },
    "al":  { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 8, "description": "Allergies" },
    "cc":  { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 6, "description": "Critical conditions" },
    "med": { "type": "array", "items": { "type": "string", "maxLength": 50 }, "maxItems": 6, "description": "Current medicines" },
    "org": { "type": "boolean", "description": "Organ donor" },
    "ec": {
      "type": "array",
      "maxItems": 3,
      "description": "Emergency contacts",
      "items": {
        "type": "object",
        "required": ["n", "p"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "string", "maxLength": 40 },
          "r": { "type": "string", "maxLength": 20, "description": "Relation" },
          "p": { "type": "string", "pattern": "^\\+[0-9]{8,15}$", "description": "E.164 phone number" }
        }
      }
    },
    "ts":  { "type": "integer", "description": "Unix seconds when the server signed this payload" }
  }
}
