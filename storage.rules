rules_version = '2';

// Medical files live at records/{uid}/{fileId}. Citizens upload their own; doctors download through
// short-lived signed URLs from the getFileUrl function, never directly.
service firebase.storage {
  match /b/{bucket}/o {
    match /records/{uid}/{fileId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /doctorDocs/{uid}/{fileId} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
    }
  }
}
